# ==============================================================================
# Distributed Rate Limiter - Environment Template (.env.example)
# Copy this file to .env and customize values for your environment.
# ==============================================================================

# Application & Network Ports
APP_PORT=8080
REDIS_PORT=6379

# Redis Connection Settings
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_DATABASE=0
SPRING_DATA_REDIS_TIMEOUT=2000ms

# Active Spring Profile (docker, production, or default)
SPRING_PROFILES_ACTIVE=docker

# Graceful Shutdown
SERVER_SHUTDOWN=graceful
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=30s

# Rate Limiter Default Rules
RATELIMITER_CAPACITY=10
RATELIMITER_REFILLRATE=2
RATELIMITER_CLEANUP_INTERVAL_MS=60000

# Security: Admin HTTP Basic Auth Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Security: Pre-configured API Keys (comma-separated)
RATELIMITER_API_KEYS=api-key-1,api-key-2,premium-key-123

# Docker Hub Registry (for deployment)
DOCKERHUB_USERNAME=your-dockerhub-username
DOCKERHUB_IMAGE=your-dockerhub-username/distributed_rate_limiter
